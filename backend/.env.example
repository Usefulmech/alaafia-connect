APP_ENV=development
APP_ORIGIN=http://localhost:5173
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_server_api_key
APPWRITE_DATABASE_ID=alaafia
APPWRITE_BUCKET_ID=
######### Cencori (AI Gateway) #################
# Cencori settings. The client reads `CENCORI_API_KEY` from the environment.
# Base URL defaults to https://cencori.com when left empty.
CENCORI_API_KEY=your_cencori_key
# Optional: override the base URL (for staging/self-hosted deployments)
CENCORI_BASE_URL=
# Optional: provider-specific endpoint path (left empty by default)
CENCORI_ENDPOINT=
YARNGPT_API_KEY=your_yarngpt_key
YARNGPT_ENDPOINT=

# Aethex (English voice agent)
AETHEX_API_KEY=your_aethex_key
AETHEX_ENDPOINT=https://api.aethexai.com/api/v1

GTRANSLATE_DEFAULT_LANGUAGE=en
